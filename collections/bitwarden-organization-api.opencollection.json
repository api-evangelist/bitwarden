{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bitwarden Public Collections Organization API",
    "version": "latest"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://identity.bitwarden.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Import members and groups.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bitwarden.com/public/organization/import",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Import members and groups from an external system."
        }
      ]
    }
  ],
  "bundled": true
}